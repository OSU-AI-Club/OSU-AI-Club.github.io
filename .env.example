# Copy this file to `.env` and fill in the value.
#
#   cp .env.example .env
#
# `.env` is gitignored — never commit a real key.
#
# Only needed to run `npm run sync:calendar` locally. The deployed site gets
# this from the GOOGLE_CALENDAR_API_KEY repository secret instead, and the app
# itself never uses it: the key stays on the build machine and only the
# resulting events are shipped to the browser.
#
# To create one:
#   1. https://console.cloud.google.com -> new project
#   2. APIs & Services -> Library -> enable "Google Calendar API"
#   3. Credentials -> Create credentials -> API key
#   4. Restrict it: API restriction = Google Calendar API
#                   Application restriction = None
#      (An HTTP-referrer restriction breaks server-side use. See docs/calendar-sync.md.)
GOOGLE_CALENDAR_API_KEY=
